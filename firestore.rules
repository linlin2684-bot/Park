rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // 每個人的帳號資料：只有自己能讀寫
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 兩人空間：只有兩個成員能讀寫
    match /couples/{cid} {
      // 建立：只能把自己放進去
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      // 讀取：成員可以讀；還沒滿兩人時，持有邀請碼的人可以讀（才能加入）
      allow get: if signedIn() && (resource == null
                    || request.auth.uid in resource.data.members
                    || resource.data.members.size() < 2);
      // 更新：成員可以改；或是第二個人用邀請碼加入自己
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members ||
        (resource.data.members.size() == 1
          && request.resource.data.members.size() == 2
          && request.resource.data.members[0] == resource.data.members[0]
          && request.resource.data.members[1] == request.auth.uid)
      );

      // 空間裡的所有資料（票券、點數、旅行……）只有成員能讀寫
      match /{sub=**} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/couples/$(cid)).data.members;
      }
    }
  }
}
